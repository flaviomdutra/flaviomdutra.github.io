---
import "../styles/global.css";
const {
  title = "Flávio Dutra",
  description = "Flávio Dutra — projects, notes, and ideas.",
} = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <title>{title}</title>
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Journal RSS"
      href={`${base}rss.xml`}
    />
  </head>
  <body>
    <a class="skip" href="#main">
      Skip to content
    </a>
    <header class="wrap header">
      <a class="brand" href={base}>
        <span>~/</span>flaviomdutra
      </a>
      <nav aria-label="Main navigation">
        <a href={`${base}#about`}>about</a>
        <a href={`${base}#work`}>projects</a>
        <a href={`${base}blog/`}>blog</a>
        <a href={`${base}setup/`}>setup</a>
        <a href={`${base}Flavio_Dutra_CV.pdf`} download>
          cv ↓
        </a>
        <a href={`${base}#contact`}>contact</a>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="wrap footer">
      <span>© {new Date().getFullYear()} Flávio Dutra</span>
      <a href={`${base}rss.xml`}>RSS ↗</a>
    </footer>
  </body>
</html>
