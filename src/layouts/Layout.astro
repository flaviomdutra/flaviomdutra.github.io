---
import "../styles/global.css";
const base = import.meta.env.BASE_URL;
const relativePath = Astro.url.pathname.startsWith(base)
  ? Astro.url.pathname.slice(base.length)
  : "";
const isEnglish = relativePath === "en" || relativePath.startsWith("en/");
const pagePath = isEnglish ? relativePath.replace(/^en\/?/, "") : relativePath;
const home = `${base}${isEnglish ? "en/" : ""}`;
const alternate = `${base}${isEnglish ? "" : "en/"}${pagePath}`;
const {
  title = "Flávio Dutra",
  description = isEnglish
    ? "Flávio Dutra — projects, notes, and ideas."
    : "Flávio Dutra — projetos, notas e ideias.",
} = Astro.props;
---

<!doctype html>
<html lang={isEnglish ? "en" : "pt-BR"}>
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      try {
        if (localStorage.getItem("theme") === "light") {
          document.documentElement.dataset.theme = "light";
        }
      } catch {}
    </script>
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <title>{title}</title>
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Journal RSS"
      href={`${base}rss.xml`}
    />
  </head>
  <body>
    <a class="skip" href="#main">
      {isEnglish ? "Skip to content" : "Ir para o conteúdo"}
    </a>
    <header class="wrap header">
      <a class="brand" href={home}>
        <span>~/</span>flaviomdutra
      </a>
      <nav aria-label={isEnglish ? "Main navigation" : "Navegação principal"}>
        <a href={`${home}#about`}>{isEnglish ? "about" : "sobre"}</a>
        <a href={`${home}#work`}>{isEnglish ? "projects" : "carreira"}</a>
        <a href={`${home}blog/`}>blog</a>
        <a href={`${home}setup/`}>setup</a>
        <a href={`${base}Flavio_Dutra_CV.pdf`}>cv</a>
        <a href={`${home}#contact`}>{isEnglish ? "contact" : "contato"}</a>
        <a href={alternate} hreflang={isEnglish ? "pt-BR" : "en"}>
          {isEnglish ? "pt" : "en"}
        </a>
      </nav>
      <button
        class="theme-toggle"
        type="button"
        data-light-label={
          isEnglish ? "Switch to light theme" : "Ativar tema claro"
        }
        data-dark-label={
          isEnglish ? "Switch to dark theme" : "Ativar tema escuro"
        }
        aria-label={isEnglish ? "Switch to light theme" : "Ativar tema claro"}
      >
        <span class="sun" aria-hidden="true">
          ☀
        </span>
        <span class="moon" aria-hidden="true">
          ☾
        </span>
      </button>
    </header>
    <script>
      const button = document.querySelector<HTMLButtonElement>(".theme-toggle");
      const updateLabel = () => {
        if (!button) return;
        const light = document.documentElement.dataset.theme === "light";
        button.setAttribute(
          "aria-label",
          (light ? button.dataset.darkLabel : button.dataset.lightLabel) || "",
        );
        button.title = button.getAttribute("aria-label") || "";
      };
      updateLabel();
      button?.addEventListener("click", () => {
        const theme =
          document.documentElement.dataset.theme === "light" ? "dark" : "light";
        document.documentElement.dataset.theme = theme;
        try {
          localStorage.setItem("theme", theme);
        } catch {}
        updateLabel();
      });
    </script>
    <main id="main">
      <slot />
    </main>
    <footer class="wrap footer">
      <span>© {new Date().getFullYear()} Flávio Dutra</span>
      <a href={`${base}rss.xml`}>RSS ↗</a>
    </footer>
  </body>
</html>
