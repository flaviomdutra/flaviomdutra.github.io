---
import Layout from "../../layouts/Layout.astro";
const base = `${import.meta.env.BASE_URL}en/`;
---

<Layout>
  <div class="wrap content home">
    <section class="home-intro" id="about">
      <div class="home-intro-copy">
        <p class="prompt">
          ~/home <span>$</span> whoami
        </p>
        <h1>Flávio Dutra</h1>
        <p class="home-lead">
          At Bradesco, I help teams modernize credit recovery platforms that
          connect cloud services, on-premises systems, and mainframes. My work
          spans architecture decisions, systems integration, and hands-on
          collaboration with engineering teams.
        </p>
        <p>
          I also explore how AI agents can integrate with business systems,
          building proofs of concept with tools such as Google ADK, MCP, and
          Azure OpenAI Real-Time.
        </p>
      </div>
      <img
        class="home-portrait"
        src="https://github.com/flaviomdutra.png?size=400"
        alt="Flávio Dutra"
        width="240"
        height="240"
      />
    </section>

    <section class="home-section" id="work">
      <h2>Experience & interests</h2>
      <div>
        <p>
          I have worked in software for more than 13 years, including at SYS4B,
          Oracle, and Cognizant. Along the way, I have worked in development,
          technical leadership, and distributed systems architecture.
        </p>
        <p>
          I am interested in backend engineering, event-driven architecture, and
          data integration, especially the challenge of evolving systems while
          keeping their domain and the people working on them in mind.
        </p>
      </div>
    </section>

    <section class="home-section home-writing">
      <div>
        <h2>Writing</h2>
        <p>Notes and practical ideas from building software.</p>
        <a class="home-text-link" href={`${base}blog/`}>
          All writing →
        </a>
      </div>
      <article class="home-article">
        <p class="home-eyebrow">Architecture</p>
        <h3>
          <a href={`${base}blog/microservice-coupling/`}>
            Understanding coupling in microservices
          </a>
        </h3>
        <p>
          A practical look at domain, contract, and runtime coupling, and how to
          keep changes manageable in distributed systems.
        </p>
        <a class="home-text-link" href={`${base}blog/microservice-coupling/`}>
          Read article →
        </a>
      </article>
    </section>

    <section class="home-section home-contact" id="contact">
      <h2>Find me online</h2>
      <div class="social">
        <a href="https://github.com/flaviomdutra">GitHub ↗</a>
        <a href="https://www.linkedin.com/in/flaviomdutra/">LinkedIn ↗</a>
        <a href="https://instagram.com/flaviomdutra">Instagram ↗</a>
        <a href="mailto:flaviomdutra@outlook.com">Email ↗</a>
      </div>
    </section>
  </div>
</Layout>
