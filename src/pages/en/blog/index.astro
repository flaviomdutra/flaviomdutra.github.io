---
import Layout from "../../../layouts/Layout.astro";
const base = `${import.meta.env.BASE_URL}en/`;
---

<Layout title="Blog — Flávio Dutra">
  <div class="wrap content page">
    <p class="prompt">
      ~/blog <span>$</span> ls
    </p>
    <h1>
      Blog<span class="accent">.</span>
    </h1>
    <p>
      Notes on software architecture, backend engineering, distributed systems,
      and learning along the way.
    </p>
    <a class="post" href={`${base}blog/microservices-essential-concepts/`}>
      <span class="post-content">
        <span class="post-title">Essential microservices concepts</span>
        <span class="post-summary">
          An overview of service autonomy, domain boundaries, data ownership, and
          communication choices.
        </span>
        <span class="post-tags" aria-label="Tags">
          <span class="post-tag">Microservices</span>
          <span class="post-tag">Software architecture</span>
          <span class="post-tag">Distributed systems</span>
        </span>
      </span>
      <span class="post-category">Architecture →</span>
    </a>
  </div>
</Layout>
