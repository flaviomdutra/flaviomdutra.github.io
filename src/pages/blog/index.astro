---
import Layout from "../../layouts/Layout.astro";
import { getBlogPosts, getCategoryLabel, getTagLabel } from "../../data/blog";
const base = import.meta.env.BASE_URL;
const posts = getBlogPosts("pt");
---

<Layout title="Blog — Flávio Dutra">
  <div class="wrap content page">
    <p class="prompt">
      ~/blog <span>$</span> ls
    </p>
    <h1>
      Blog<span class="accent">.</span>
    </h1>
    <p>
      Notas sobre arquitetura de software, engenharia backend, sistemas
      distribuídos e aprendizados pelo caminho.
    </p>
    {posts.map((post) => (
      <a class="post" href={`${base}blog/${post.slug}/`}>
        <span class="post-content">
          <span class="post-title">{post.title}</span>
          <span class="post-summary">{post.summary}</span>
          <span class="post-tags" aria-label="Tags">
            {post.tags.map((tag) => <span class="post-tag">{getTagLabel(tag, "pt")}</span>)}
          </span>
        </span>
        <span class="post-category">{getCategoryLabel(post.category, "pt")} →</span>
      </a>
    ))}
  </div>
</Layout>
