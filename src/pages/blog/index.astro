---
import Layout from "../../layouts/Layout.astro";
const base = import.meta.env.BASE_URL;
---

<Layout title="Blog — Flávio Dutra">
  <div class="wrap content page">
    <p class="prompt">
      ~/blog <span>$</span> ls
    </p>
    <h1>
      Blog<span class="accent">.</span>
    </h1>
    <p>
      Notas sobre arquitetura de software, engenharia backend, sistemas
      distribuídos e aprendizados pelo caminho.
    </p>
    <a class="post" href={`${base}blog/microservices-essential-concepts/`}>
      <span class="post-content">
        <span class="post-title">Conceitos essenciais de microsserviços</span>
        <span class="post-summary">
          Um panorama sobre autonomia dos serviços, limites de domínio,
          responsabilidade pelos dados e escolhas de comunicação.
        </span>
        <span class="post-tags" aria-label="Tags">
          <span class="post-tag">Microsserviços</span>
          <span class="post-tag">Arquitetura de software</span>
          <span class="post-tag">Sistemas distribuídos</span>
        </span>
      </span>
      <span class="post-category">Arquitetura →</span>
    </a>
  </div>
</Layout>
