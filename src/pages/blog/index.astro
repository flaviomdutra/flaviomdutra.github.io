---
import Layout from "../../layouts/Layout.astro";
const base = import.meta.env.BASE_URL;
---

<Layout title="Blog — Flávio Dutra">
  <div class="wrap content page">
    <p class="prompt">
      ~/blog <span>$</span> ls
    </p>
    <h1>
      Blog<span class="accent">.</span>
    </h1>
    <p>
      Notas sobre arquitetura de software, engenharia backend, sistemas
      distribuídos e aprendizados pelo caminho.
    </p>
    <a class="post" href={`${base}blog/microservice-coupling/`}>
      <span>Entendendo o acoplamento em microsserviços</span>
      <span>Arquitetura →</span>
    </a>
  </div>
</Layout>
